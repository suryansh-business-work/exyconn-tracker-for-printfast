{{#if tracker.requests}}
  <!-- improved styles for the scrollable area and nicer table -->
  <style>
    :root{
      --card-bg:#ffffff;
      --muted:#6b7280;
      --accent:#0f172a;
      --border:#e6edf3;
      --stripe:#fbfdff;
      --primary:#2563eb;
    }
    #table-controls{
      margin: 12px 0;
      display:flex;
      gap:12px;
      align-items:center;
      flex-wrap:wrap;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      color:var(--muted);
    }
    #table-wrapper{
      max-height: 480px;
      overflow:auto;
      border-radius:8px;
      border:1px solid var(--border);
      box-shadow: 0 6px 18px rgba(16,24,40,0.06);
      background: linear-gradient(180deg, var(--card-bg), var(--stripe));
    }
    .scrollable-table{
      width:100%;
      border-collapse:collapse;
      font-family: inherit;
      min-width:720px;
    }
    .scrollable-table thead th{
      position: sticky;
      top:0;
      background: linear-gradient(180deg,#fff,#fbfdff);
      z-index:2;
      text-align:left;
      padding:12px 14px;
      font-weight:600;
      font-size:13px;
      color:var(--accent);
      border-bottom:1px solid var(--border);
    }
    .scrollable-table tbody td{
      padding:10px 14px;
      font-size:13px;
      color:#111827;
      border-bottom:1px solid rgba(15,23,42,0.04);
    }
    .scrollable-table tbody td.referrer-cell{
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 13px;
      color: #2563eb;
    }
    .referrer-cell a{
      color: #2563eb;
      text-decoration: none;
    }
    .referrer-cell a:hover{
      text-decoration: underline;
    }
    .scrollable-table tbody td.referrer-cell:hover{
      overflow: visible;
      white-space: normal;
      word-break: break-all;
    }
    .referrer-direct{
      color: #6b7280;
      font-style: italic;
    }
    .ip-column{
      display: none;
    }
    .scrollable-table tbody tr:nth-child(even){
      background: rgba(37,99,235,0.02);
    }
    .scrollable-table tbody tr:hover{
      background: rgba(37,99,235,0.04);
    }
    .controls-btn{
      background: #fff;
      border:1px solid var(--border);
      padding:6px 10px;
      border-radius:6px;
      cursor:pointer;
      font-size:13px;
    }
    .controls-btn[disabled]{ opacity:0.5; cursor:not-allowed; }
    #page-info{ color:var(--muted); font-size:13px; }
    #page-size{ padding:6px 8px; border-radius:6px; border:1px solid var(--border); }
    @media (max-width:800px){
      .scrollable-table{ min-width:600px; }
    }
  </style>

  <!-- pagination controls -->
  <div id="table-controls">
    <label>Rows:
      <select id="page-size">
        <option value="5">5</option>
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="50">50</option>
      </select>
    </label>

    <!-- change: pagination buttons get MDC styling for visual consistency -->
    <button id="prev-page" type="button" class="icon-btn mdc-button" aria-label="Previous page"><i class="fa-solid fa-chevron-left"></i></button>
    <button id="next-page" type="button" class="icon-btn mdc-button" aria-label="Next page"><i class="fa-solid fa-chevron-right"></i></button>
    <span id="page-info" style="margin-left:8px;">Page 1 / 1</span>
  </div>

  <!-- scrollable wrapper -->
  <div id="table-wrapper">
    <table id="tracker-table" class="scrollable-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Timestamp</th>
          <th class="ip-column">IP</th>
          <th>Referrer Page</th>
          <th>Location</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody id="tracker-tbody">
        {{#each tracker.requests}}
          <tr>
            <td>{{this.id}}</td>
            <!-- keep original ISO timestamp in data-ts for client formatting -->
            <td><span class="ts" data-ts="{{this.timestamp}}">{{this.timestamp}}</span></td>
            <td class="ip-column">{{this.ip}}</td>
            <td class="referrer-cell" title="{{this.referrer}}" data-referrer="{{this.referrer}}">
              {{#if this.referrer}}
                <a href="{{this.referrer}}" target="_blank" rel="noopener noreferrer" class="referrer-link">{{this.referrer}}</a>
              {{else}}
                <span class="referrer-direct">Direct</span>
              {{/if}}
            </td>
            <td class="loc-cell">
              <span class="loc-flag" aria-hidden="true">{{this.flag}}</span>
              <div style="display:inline-block; vertical-align:middle; margin-left:8px;">
                <div class="loc-city" style="font-weight:600">{{#if this.city}}{{this.city}}{{else}}&ndash;{{/if}}</div>
                <div class="loc-tz" style="color:#6b7280; font-size:12px">{{#if this.timezone}}{{this.timezone}}{{else}}&ndash;{{/if}}</div>
              </div>
            </td>
            <td>{{this.count}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <p id="no-requests">No requests recorded.</p>
{{/if}}

