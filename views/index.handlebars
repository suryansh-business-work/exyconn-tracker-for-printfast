<script>
  // Initialize MDC ripples for buttons that now have mdc-button class
  (function() {
    if (window.mdc && window.mdc.ripple && window.mdc.textField) {
      try {
        // Attach ripples to all buttons that received the mdc-button class
        Array.from(document.querySelectorAll('.mdc-button')).forEach(function(el){
          new mdc.ripple.MDCRipple(el);
        });

        // Initialize the outlined text field for the search input
        var tfEl = document.querySelector('.mdc-text-field');
        if (tfEl) {
          new mdc.textField.MDCTextField(tfEl);
        }
      } catch (e) {
        console.warn('MDC init failed:', e);
      }
    }

    // Handle "Direct" referrer display
    document.querySelectorAll('.referrer-cell').forEach(function(cell) {
      var referrer = cell.getAttribute('data-referrer');
      if (!referrer || referrer === 'Direct' || referrer.trim() === '') {
        cell.innerHTML = '<span class="referrer-direct">Direct</span>';
      }
    });
  })();
</script>
